{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lynn-words-sync",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {"enabled": true, "head_sampling_rate": 1},
    "traces": {"enabled": true, "head_sampling_rate": 0.05}
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://dreamdavidmit-glitch.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lynn-words-progress",
      "database_id": "95c993a7-5f0b-45d1-87d6-b5b7bf330d31",
      "migrations_dir": "migrations"
    }
  ]
}
